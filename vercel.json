{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python3.14 manage.py collectstatic --noinput",
  "outputDirectory": "staticfiles",
  "functions": {
    "api/index.py": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
